{
    "MedvedCell": {
        "Enabled": true,
        "IsDebugEnabled": false,
        "IsRealDebugEnabled": false,
        "DebugForceSpawn": false,
        "AvoidTakenBossZones": true,

        // Spawn chance stays config-driven. Quest progression does not change chance.
        // Quest progression only changes difficulty and which maps/zones are allowed.
        "SpawnChances": {
            "bigmap": 3,
            "rezervbase": 4,
            "tarkovstreets": 2,
            "sandbox": 2,
            "interchange": 3
        },

        // Fallback zone table. Active stage map/zones are defined in MedvedStageRules.cs.
        "SpawnZones": {
            "bigmap": "ZoneDormitory,ZoneGasStation,ZoneFactoryCenter",
            "rezervbase": "ZoneRailStrorage,ZoneKnight,ZoneBunkerStorage",
            "tarkovstreets": "ZoneCarShowroom,ZoneCinema,ZoneHotel_1",
            "sandbox": "ZoneSandboxMain,ZoneSandboxExit",
            "interchange": "ZoneCenter,ZoneIDEA,ZoneOLI"
        },

        // Tony main story completion controls the Medved stage.
        // YATMMedved only adds one WTT quest: yatm_medved_the_last_cell.
        // That quest is the final Stage 6 payoff; it does not control the ramp.
        // Stage effects are code-defined:
        // Stage 0 = easy       = Reserve only
        // Stage 1 = easy       = Customs + Reserve
        // Stage 2 = normal     = Customs + Reserve
        // Stage 3 = normal     = Customs + Reserve + Interchange
        // Stage 4 = hard       = Customs + Reserve + Interchange + Streets
        // Stage 5 = hard       = Customs + Reserve + Interchange + Streets + Ground Zero
        // Stage 6 = impossible = All Medved maps/zones
        "QuestProgression": {
            "Enabled": true,

            "Stages": [
                {
                    "Name": "Stage 1 - First Medved Movement / Tony Quest 15",
                    "RequiredQuestIds": [
                        "6a4341ac38a6d33bffe9829e"
                    ],
                    "RequireAllQuestIds": true
                },
                {
                    "Name": "Stage 2 - Medved Pressure / Tony Quest 19",
                    "RequiredQuestIds": [
                        "66aa00000000000000000013"
                    ],
                    "RequireAllQuestIds": true
                },
                {
                    "Name": "Stage 3 - Medved Expansion / Tony Quest 23",
                    "RequiredQuestIds": [
                        "66aa00000000000000000017"
                    ],
                    "RequireAllQuestIds": true
                },
                {
                    "Name": "Stage 4 - Medved Hard Hunt / Tony Quest 28",
                    "RequiredQuestIds": [
                        "66aa0000000000000000001c"
                    ],
                    "RequireAllQuestIds": true
                },
                {
                    "Name": "Stage 5 - Last Warning / Tony Quest 29",
                    "RequiredQuestIds": [
                        "66aa0000000000000000001d"
                    ],
                    "RequireAllQuestIds": true
                },
                {
                    "Name": "Stage 6 - Full Cell Active / Tony Quest 30",
                    "RequiredQuestIds": [
                        "66aa0000000000000000001e"
                    ],
                    "RequireAllQuestIds": true
                }
            ],

            // Legacy single-quest fields are intentionally empty.
            // If QuestId is set and completed, MedvedSpawnController treats it as Stage 6.
            "QuestId": "",
            "CompletedSpawnChances": {},
            "CompletedSpawnZones": {}
        }
    }
}
