<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<RootNamespace>YATMMedved</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<Version>1.0.0</Version>
		<AssemblyName>yatm-medved-server</AssemblyName>

		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>

		<OutputPath>bin\$(Configuration)\$(MSBuildProjectName)\$(AssemblyName)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<EnableDefaultContentItems>false</EnableDefaultContentItems>

		<DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>

		<!-- Change this if your SPT folder is somewhere else. Do NOT prefix this with $(ProjectDir). -->
		<SptInstallPath Condition="'$(SptInstallPath)' == ''">C:\RealSPT</SptInstallPath>

		<!-- Change this to YetAnotherTraderMod if you want this to deploy inside your existing Tony/YATM mod folder. -->
		<ServerModFolderName Condition="'$(ServerModFolderName)' == ''">YATMMedved</ServerModFolderName>
		<ServerModDeployDir>$(SptInstallPath)\SPT\user\mods\$(ServerModFolderName)\</ServerModDeployDir>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="config.jsonc">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="db\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SPTarkov.Common" Version="4.0.13" />
		<PackageReference Include="SPTarkov.DI" Version="4.0.13" />
		<PackageReference Include="SPTarkov.Server.Core" Version="4.0.13" />
		<PackageReference Include="SPTarkov.Reflection" Version="4.0.13" />
		<PackageReference Include="WTT-ServerCommonLib" Version="2.0.20" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="MoreBotsServer">
			<Private>false</Private>
			<HintPath>..\Reference\MoreBotsServer\MoreBotsServer.dll</HintPath>
		</Reference>

		<Reference Include="YetAnotherTraderMod">
			<Private>false</Private>
			<HintPath>..\..\YetAnotherTraderMod\YetAnotherTraderMod-ServerMod\bin\Debug\YetAnotherTraderMod.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="db\CustomTraderOffers\" />
		<Folder Include="db\CustomConsumables\" />
	</ItemGroup>

	<Target Name="DeployServerModToSPT" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
		<MakeDir Directories="$(ServerModDeployDir)" />
		<MakeDir Directories="$(ServerModDeployDir)db\" />

		<ItemGroup>
			<DbDeployFiles Include="$(ProjectDir)db\**\*.*" />
		</ItemGroup>

		<Message Importance="High" Text="Deploying YATMMedved to: $(ServerModDeployDir)" />
		<Message Importance="High" Text="ProjectDir: $(ProjectDir)" />
		<Message Importance="High" Text="Config path: $(ProjectDir)config.jsonc" />

		<Error
			Text="Missing config.jsonc at $(ProjectDir)config.jsonc"
			Condition="!Exists('$(ProjectDir)config.jsonc')" />

		<!-- Copy server mod DLL -->
		<Copy
			SourceFiles="$(TargetPath)"
			DestinationFiles="$(ServerModDeployDir)$(TargetFileName)"
			SkipUnchangedFiles="false" />

		<!-- Copy root config.jsonc -->
		<Copy
			SourceFiles="$(ProjectDir)config.jsonc"
			DestinationFiles="$(ServerModDeployDir)config.jsonc"
			SkipUnchangedFiles="false" />

		<!-- Copy db folder -->
		<Copy
			SourceFiles="@(DbDeployFiles)"
			DestinationFiles="@(DbDeployFiles->'$(ServerModDeployDir)db\%(RecursiveDir)%(Filename)%(Extension)')"
			SkipUnchangedFiles="false"
			Condition="'@(DbDeployFiles)' != ''" />
	</Target>

</Project>