<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <AssemblyName>YATMMedvedPlugin</AssemblyName>
    <Description>YATM Medved runtime client plugin.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <RootNamespace>YetAnotherTraderMod</RootNamespace>

    <!-- Change this if your SPT folder is somewhere else. Do NOT prefix this with $(ProjectDir). -->
    <SptInstallPath Condition="'$(SptInstallPath)' == ''">C:\RealSPT</SptInstallPath>
    <PluginDeployDir>$(SptInstallPath)\BepInEx\plugins\yatm-medved\</PluginDeployDir>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prepatch\Prepatch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptInstallPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="MoreBotsPlugin">
      <HintPath>..\Reference\MoreBotsAPI\MoreBotsPlugin.dll</HintPath>
    </Reference>
    <Reference Include="MoreBotsPrepatch">
      <HintPath>..\Reference\MoreBotsPrepatch.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptInstallPath)\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptInstallPath)\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(SptInstallPath)\BepInEx\plugins\spt\spt-common.dll</HintPath>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(SptInstallPath)\BepInEx\plugins\spt\spt-reflection.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptInstallPath)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptInstallPath)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="DeployPluginToSPT" AfterTargets="Build">
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
